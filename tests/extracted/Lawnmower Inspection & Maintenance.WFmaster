    {
      "local_id": "Spark Plug Disconnect",
      "oid": "7000000000011",
      "version": "1.0.0",
      "last_modified_date": "2026-03-03T02:53:11.342Z",
      "step_type": "USER_INTERACTION",
      "ui_parameter_specifications": [
        {
          "oid": "7000000000002",
          "type": "Header",
          "value": "Spark Plug Disconnect",
          "font_size": 22,
          "align": "center"
        },
        {
          "oid": "7000000000003",
          "type": "Image",
          "value": "engine-closeup.jpg"
        },
        {
          "oid": "7000000000004",
          "type": "Divider",
          "value": ""
        },
        {
          "oid": "7000000000005",
          "type": "Text",
          "value": "MANDATORY FIRST STEP: Locate the spark plug",
          "font_size": 15
        },
        {
          "oid": "7000000000006",
          "type": "Text",
          "value": "on top of the engine. Pull the rubber boot",
          "font_size": 15
        },
        {
          "oid": "7000000000007",
          "type": "Text",
          "value": "firmly off the spark plug terminal to prevent",
          "font_size": 15
        },
        {
          "oid": "7000000000008",
          "type": "Text",
          "value": "accidental engine startup during maintenance.",
          "font_size": 15
        },
        {
          "oid": "7000000000009",
          "type": "SmallText",
          "value": "Never work under or near the blade without disconnecting the spark plug first.",
          "font_size": 13,
          "color": "#555555"
        },
        {
          "oid": "7000000000010",
          "type": "Button",
          "value": "Done"
        }
      ],
