    {
      "local_id": "Simmer Sauce",
      "oid": "5000000000120",
      "version": "1.0.0",
      "last_modified_date": "2026-03-02T20:18:19.316Z",
      "step_type": "USER_INTERACTION",
      "ui_parameter_specifications": [
        {
          "oid": "5000000000111",
          "type": "Header",
          "value": "Simmer the Sauce (30 min)",
          "font_size": 22,
          "align": "center"
        },
        {
          "oid": "5000000000112",
          "type": "Image",
          "value": "simmer-sauce.jpg"
        },
        {
          "oid": "5000000000113",
          "type": "Divider",
          "value": ""
        },
        {
          "oid": "5000000000114",
          "type": "Text",
          "value": "Reduce heat to LOW.",
          "font_size": 15
        },
        {
          "oid": "5000000000115",
          "type": "Text",
          "value": "Partially cover with a lid (leave a gap for steam).",
          "font_size": 15
        },
        {
          "oid": "5000000000116",
          "type": "Text",
          "value": "Simmer gently for 30 minutes, stirring every 8-10 minutes.",
          "font_size": 15
        },
        {
          "oid": "5000000000117",
          "type": "Text",
          "value": "The sauce will thicken and the flavors meld.",
          "font_size": 15
        },
        {
          "oid": "5000000000118",
          "type": "SmallText",
          "value": "Too thick? Add a splash of pasta water. Too thin? Remove the lid to evaporate.",
          "font_size": 13,
          "color": "#555555"
        },
        {
          "oid": "5000000000119",
          "type": "Button",
          "value": "Done"
        }
      ],
