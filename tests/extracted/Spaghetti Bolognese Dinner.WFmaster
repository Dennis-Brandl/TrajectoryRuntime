    {
      "local_id": "Adjust Seasoning",
      "oid": "5000000000151",
      "version": "1.0.0",
      "last_modified_date": "2026-03-02T20:18:19.316Z",
      "step_type": "USER_INTERACTION",
      "ui_parameter_specifications": [
        {
          "oid": "5000000000143",
          "type": "Header",
          "value": "Adjust Seasoning",
          "font_size": 22,
          "align": "center"
        },
        {
          "oid": "5000000000144",
          "type": "Divider",
          "value": ""
        },
        {
          "oid": "5000000000145",
          "type": "Text",
          "value": "Add salt in small pinches, stirring and tasting after each.",
          "font_size": 15
        },
        {
          "oid": "5000000000146",
          "type": "Text",
          "value": "Add freshly ground black pepper to taste.",
          "font_size": 15
        },
        {
          "oid": "5000000000147",
          "type": "Text",
          "value": "If too acidic, add a tiny pinch of sugar (1/4 tsp).",
          "font_size": 15
        },
        {
          "oid": "5000000000148",
          "type": "Text",
          "value": "Stir well and simmer 1-2 more minutes.",
          "font_size": 15
        },
        {
          "oid": "5000000000149",
          "type": "SmallText",
          "value": "Season gradually — you can always add more, but can't take it away!",
          "font_size": 13,
          "color": "#555555"
        },
        {
          "oid": "5000000000150",
