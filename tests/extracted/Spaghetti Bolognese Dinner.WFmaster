    {
      "local_id": "Add Soffritto",
      "oid": "5000000000064",
      "version": "1.0.0",
      "last_modified_date": "2026-03-02T20:18:19.316Z",
      "step_type": "USER_INTERACTION",
      "ui_parameter_specifications": [
        {
          "oid": "5000000000056",
