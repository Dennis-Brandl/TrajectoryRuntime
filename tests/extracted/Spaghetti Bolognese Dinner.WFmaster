      "ui_parameter_specifications": [
        {
          "oid": "5000000000031",
          "type": "Header",
          "value": "Prepare the Soffritto",
          "font_size": 22,
          "align": "center"
        },
        {
          "oid": "5000000000032",
          "type": "Image",
          "value": "prep-vegetables.jpg"
        },
