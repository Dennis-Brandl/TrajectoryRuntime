          "value": ""
        },
        {
          "oid": "5000000000059",
          "type": "Text",
          "value": "Add the diced onion, carrot, and celery to the browned meat.",
          "font_size": 15
        },
        {
          "oid": "5000000000060",
          "type": "Text",
          "value": "Season with a pinch of salt.",
          "font_size": 15
        },
        {
          "oid": "5000000000061",
          "type": "Text",
          "value": "Cook 5-7 minutes, stirring occasionally, until softened and translucent.",
          "font_size": 15
        },
        {
          "oid": "5000000000062",
          "type": "SmallText",
          "value": "Reduce heat to medium if they start to color too fast. They should be soft, not browned.",
          "font_size": 13,
          "color": "#555555"
        },
