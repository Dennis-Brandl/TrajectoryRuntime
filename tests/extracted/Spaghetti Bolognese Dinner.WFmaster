          "oid": "5000000000033",
          "type": "Divider",
          "value": ""
        },
        {
          "oid": "5000000000034",
          "type": "Text",
          "value": "Finely dice the onion into small (3mm) pieces.",
          "font_size": 15
        },
        {
          "oid": "5000000000035",
          "type": "Text",
          "value": "Peel and finely dice the carrots.",
          "font_size": 15
        },
        {
          "oid": "5000000000036",
          "type": "Text",
          "value": "Finely dice the celery stalks.",
          "font_size": 15
        },
        {
          "oid": "5000000000037",
          "type": "Text",
          "value": "Mince the garlic cloves separately.",
          "font_size": 15
        },
        {
          "oid": "5000000000038",
          "type": "SmallText",
          "value": "The finer you dice, the more they melt into the sauce. This is the flavor base of Italian cooking.",
          "font_size": 13,
          "color": "#555555"
        },
        {
          "oid": "5000000000039",
          "type": "Button",
          "value": "Done"
        }
      ],
