    {
      "local_id": "Brown the Meat",
      "oid": "5000000000054",
      "version": "1.0.0",
      "last_modified_date": "2026-03-02T20:18:19.316Z",
      "step_type": "USER_INTERACTION",
      "ui_parameter_specifications": [
        {
          "oid": "5000000000045",
          "type": "Header",
          "value": "Brown the Ground Beef",
          "font_size": 22,
          "align": "center"
        },
        {
          "oid": "5000000000046",
          "type": "Image",
          "value": "brown-meat.jpg"
        },
        {
          "oid": "5000000000047",
          "type": "Divider",
          "value": ""
        },
        {
          "oid": "5000000000048",
          "type": "Text",
          "value": "Heat 2 tbsp olive oil + 1 tbsp butter in a large Dutch oven over medium-high heat.",
          "font_size": 15
        },
        {
          "oid": "5000000000049",
          "type": "Text",
          "value": "Add the ground beef, breaking it into pieces.",
          "font_size": 15
        },
        {
          "oid": "5000000000050",
          "type": "Text",
          "value": "Cook 5-7 minutes until well browned.",
          "font_size": 15
        },
        {
          "oid": "5000000000051",
          "type": "Text",
          "value": "Do NOT drain the fat — it adds flavor.",
          "font_size": 15
        },
        {
          "oid": "5000000000052",
          "type": "SmallText",
          "value": "Let the meat sit undisturbed for a minute to develop a good brown crust (Maillard reaction).",
          "font_size": 13,
          "color": "#555555"
        },
        {
          "oid": "5000000000053",
          "type": "Button",
          "value": "Done"
        }
      ],
