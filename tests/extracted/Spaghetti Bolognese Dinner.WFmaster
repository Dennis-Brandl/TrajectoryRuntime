          "type": "Divider",
          "value": ""
        },
        {
          "oid": "5000000000159",
          "type": "Text",
          "value": "Drain the pasta (save that pasta water!).",
          "font_size": 15
        },
        {
          "oid": "5000000000160",
          "type": "Text",
          "value": "Add drained pasta directly into the sauce pot.",
          "font_size": 15
        },
        {
          "oid": "5000000000161",
          "type": "Text",
          "value": "Toss vigorously over medium heat for 1-2 minutes.",
          "font_size": 15
        },
        {
          "oid": "5000000000162",
          "type": "Text",
          "value": "Add splashes of reserved pasta water for a silky coating.",
          "font_size": 15
        },
        {
          "oid": "5000000000163",
          "type": "SmallText",
          "value": "The starch emulsifies with fat, creating that restaurant-quality glossy finish.",
