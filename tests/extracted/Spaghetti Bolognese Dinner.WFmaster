    {
      "local_id": "Deglaze with Wine",
      "oid": "5000000000093",
      "version": "1.0.0",
      "last_modified_date": "2026-03-02T20:18:19.316Z",
      "step_type": "USER_INTERACTION",
      "ui_parameter_specifications": [
        {
          "oid": "5000000000085",
          "type": "Header",
          "value": "Deglaze with Red Wine",
          "font_size": 22,
          "align": "center"
        },
        {
          "oid": "5000000000086",
          "type": "Divider",
          "value": ""
        },
        {
          "oid": "5000000000087",
          "type": "Text",
          "value": "Pour in 1 cup (250ml) of dry red wine.",
          "font_size": 15
        },
        {
          "oid": "5000000000088",
          "type": "Text",
          "value": "Scrape the bottom of the pot to release browned bits (fond).",
          "font_size": 15
        },
        {
          "oid": "5000000000089",
          "type": "Text",
          "value": "Simmer and reduce by about half — 3-4 minutes.",
          "font_size": 15
        },
        {
          "oid": "5000000000090",
          "type": "Text",
          "value": "The alcohol will cook off, leaving rich flavor.",
          "font_size": 15
        },
        {
          "oid": "5000000000091",
          "type": "SmallText",
          "value": "You'll know it's ready when the harsh alcohol smell fades and the liquid thickens.",
          "font_size": 13,
          "color": "#555555"
        },
        {
          "oid": "5000000000092",
          "type": "Button",
          "value": "Done"
        }
      ],
