        {
          "oid": "6000000000102",
          "type": "Text",
          "value": "Engage the upper door tab first by inserting it into the top slot.",
          "font_size": 15
        },
        {
          "oid": "6000000000103",
          "type": "Text",
          "value": "Rotate the cover downward until the lower tab clicks into place.",
          "font_size": 15
        },
        {
          "oid": "6000000000104",
          "type": "Text",
          "value": "Verify the cover is flush and secure.",
          "font_size": 15
        },
        {
          "oid": "6000000000105",
          "type": "SmallText",
          "value": "The cover should snap firmly. If it feels loose, check that the filter pull tabs are folded inward and not blocking the cover.",
