    {
      "local_id": "Reorient Filters",
      "oid": "6000000000094",
      "version": "1.0.0",
      "last_modified_date": "2026-03-03T02:59:53.001Z",
      "step_type": "USER_INTERACTION",
      "ui_parameter_specifications": [
        {
          "oid": "6000000000085",
          "type": "Header",
          "value": "Fix Filter Orientation",
          "font_size": 22,
          "align": "center"
        },
        {
          "oid": "6000000000086",
          "type": "Divider",
          "value": ""
        },
        {
          "oid": "6000000000087",
          "type": "Text",
          "value": "Remove both filters from the HVAC module.",
          "font_size": 15
        },
        {
          "oid": "6000000000088",
          "type": "Text",
          "value": "Rotate them so the arrows point toward the REAR of the vehicle.",
          "font_size": 15
        },
        {
          "oid": "6000000000089",
          "type": "Text",
          "value": "Reinsert: lower filter first, then upper filter.",
          "font_size": 15
        },
        {
          "oid": "6000000000090",
          "type": "Text",
          "value": "Fold the pull tabs inward after reinsertion.",
          "font_size": 15
        },
        {
          "oid": "6000000000091",
          "type": "Text",
          "value": "Double-check the arrow direction before continuing.",
          "font_size": 15
        },
        {
          "oid": "6000000000092",
          "type": "SmallText",
          "value": "The rear of the vehicle is toward the trunk/hatch. Arrows should point away from the windshield.",
          "font_size": 13,
          "color": "#555555"
        },
        {
          "oid": "6000000000093",
          "type": "Button",
          "value": "Done"
        }
      ],
