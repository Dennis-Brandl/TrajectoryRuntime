    {
      "local_id": "Remove Old Filters",
      "oid": "6000000000055",
      "version": "1.0.0",
      "last_modified_date": "2026-03-03T02:59:53.001Z",
      "step_type": "USER_INTERACTION",
      "ui_parameter_specifications": [
        {
          "oid": "6000000000044",
          "type": "Header",
          "value": "Remove Old Filters",
          "font_size": 22,
          "align": "center"
        },
        {
          "oid": "6000000000045",
          "type": "Image",
          "value": "cabin-filter.jpg"
        },
        {
          "oid": "6000000000046",
          "type": "Divider",
          "value": ""
        },
        {
          "oid": "6000000000047",
          "type": "Text",
          "value": "There are TWO filters stacked inside the HVAC module (upper and lower).",
          "font_size": 15
        },
        {
          "oid": "6000000000048",
          "type": "Text",
          "value": "Fold the upper cabin filter's pull tabs outward.",
          "font_size": 15
        },
        {
          "oid": "6000000000049",
          "type": "Text",
          "value": "Holding the tabs, carefully pull the upper filter straight out.",
          "font_size": 15
        },
        {
          "oid": "6000000000050",
          "type": "Text",
          "value": "Be careful not to snag nearby wiring connectors.",
          "font_size": 15
        },
        {
          "oid": "6000000000051",
          "type": "Text",
          "value": "Then pull the lower filter upward and out from the module.",
          "font_size": 15
        },
        {
          "oid": "6000000000052",
          "type": "Text",
          "value": "Dispose of the old filters.",
          "font_size": 15
        },
        {
          "oid": "6000000000053",
          "type": "SmallText",
          "value": "Note the direction of the airflow arrows on the old filters before removing them — the new ones must face the same way.",
          "font_size": 13,
          "color": "#555555"
        },
        {
          "oid": "6000000000054",
          "type": "Button",
          "value": "Next"
        }
      ],
      "form_layout_config": [
        {
          "deviceType": "phone",
          "canvasWidth": 390,
