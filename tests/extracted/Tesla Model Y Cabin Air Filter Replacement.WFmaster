    {
      "local_id": "Remove Side Panel",
      "oid": "6000000000021",
      "version": "1.0.0",
      "last_modified_date": "2026-03-03T02:59:53.001Z",
      "step_type": "USER_INTERACTION",
      "ui_parameter_specifications": [
        {
          "oid": "6000000000013",
          "type": "Header",
          "value": "Remove Right Side Panel",
          "font_size": 22,
          "align": "center"
        },
        {
          "oid": "6000000000014",
          "type": "Divider",
          "value": ""
        },
        {
          "oid": "6000000000015",
          "type": "Text",
          "value": "Locate the right side panel on the center console (passenger footwell area).",
          "font_size": 15
        },
        {
          "oid": "6000000000016",
          "type": "Text",
          "value": "Working from top to bottom, carefully release the panel from the center console.",
          "font_size": 15
        },
        {
          "oid": "6000000000017",
          "type": "Text",
          "value": "Pull gently — the panel is held by clips along its edge.",
          "font_size": 15
        },
        {
          "oid": "6000000000018",
          "type": "Text",
          "value": "Set the panel aside in a safe location.",
          "font_size": 15
        },
        {
          "oid": "6000000000019",
          "type": "SmallText",
          "value": "Work slowly from top to bottom. Pulling too hard or at an angle can break the plastic retaining clips.",
          "font_size": 13,
          "color": "#555555"
        },
        {
          "oid": "6000000000020",
          "type": "Button",
          "value": "Done"
        }
      ],
      "form_layout_config": [
        {
          "deviceType": "phone",
          "canvasWidth": 390,
