      "step_type": "USER_INTERACTION",
      "ui_parameter_specifications": [
        {
          "oid": "6000000000002",
          "type": "Header",
          "value": "Prepare the Vehicle",
          "font_size": 22,
          "align": "center"
        },
        {
          "oid": "6000000000003",
          "type": "Image",
          "value": "car-interior.jpg"
        },
        {
          "oid": "6000000000004",
          "type": "Divider",
          "value": ""
        },
        {
          "oid": "6000000000005",
          "type": "Text",
          "value": "Turn off the climate control system using the touchscreen.",
          "font_size": 15
        },
        {
          "oid": "6000000000006",
          "type": "Text",
          "value": "Open the front right-hand (passenger) side door.",
          "font_size": 15
        },
        {
          "oid": "6000000000007",
          "type": "Text",
          "value": "Move the front passenger seat fully rearward.",
          "font_size": 15
        },
        {
          "oid": "6000000000008",
          "type": "Text",
          "value": "Remove the passenger side floor mat and set it aside.",
          "font_size": 15
        },
        {
          "oid": "6000000000009",
          "type": "SmallText",
          "value": "Ensure the climate system is completely off to avoid blowing debris into the cabin during filter replacement.",
          "font_size": 13,
          "color": "#555555"
        },
        {
          "oid": "6000000000010",
          "type": "Button",
          "value": "Done"
        }
      ],
