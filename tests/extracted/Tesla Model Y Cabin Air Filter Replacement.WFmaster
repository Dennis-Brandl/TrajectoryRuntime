    {
      "local_id": "Install New Filters",
      "oid": "6000000000076",
      "version": "1.0.0",
      "last_modified_date": "2026-03-03T02:59:53.001Z",
      "step_type": "USER_INTERACTION",
      "ui_parameter_specifications": [
        {
          "oid": "6000000000068",
          "type": "Header",
          "value": "Install New Filters",
          "font_size": 22,
          "align": "center"
        },
        {
          "oid": "6000000000069",
          "type": "Divider",
          "value": ""
        },
        {
          "oid": "6000000000070",
          "type": "Text",
          "value": "Ensure the arrows on BOTH new filters face toward the rear of the vehicle.",
          "font_size": 15
        },
        {
          "oid": "6000000000071",
          "type": "Text",
          "value": "Insert the LOWER filter first — slide it into the bottom slot of the HVAC module.",
          "font_size": 15
        },
        {
          "oid": "6000000000072",
          "type": "Text",
          "value": "Then insert the UPPER filter above it.",
          "font_size": 15
        },
        {
          "oid": "6000000000073",
          "type": "Text",
          "value": "Fold the pull tabs inward after insertion to clear the cover.",
          "font_size": 15
        },
        {
          "oid": "6000000000074",
          "type": "SmallText",
          "value": "The airflow arrow direction is critical. Arrows must point toward the REAR of the vehicle. Reversed filters will not seal properly.",
          "font_size": 13,
          "color": "#555555"
        },
        {
          "oid": "6000000000075",
          "type": "Button",
          "value": "Done"
        }
      ],
