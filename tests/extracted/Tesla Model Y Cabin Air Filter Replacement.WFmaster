    {
      "local_id": "Remove Footwell Cover",
      "oid": "6000000000032",
      "version": "1.0.0",
      "last_modified_date": "2026-03-03T02:59:53.001Z",
      "step_type": "USER_INTERACTION",
      "ui_parameter_specifications": [
        {
          "oid": "6000000000023",
          "type": "Header",
          "value": "Remove Footwell Cover",
          "font_size": 22,
          "align": "center"
        },
        {
          "oid": "6000000000024",
          "type": "Divider",
          "value": ""
        },
        {
          "oid": "6000000000025",
          "type": "Text",
          "value": "Release the push clips (or magnets) securing the front right footwell cover to the instrument panel.",
          "font_size": 15
        },
        {
          "oid": "6000000000026",
          "type": "Text",
          "value": "Support the footwell cover as you release it — it has electrical connections.",
          "font_size": 15
        },
        {
          "oid": "6000000000027",
          "type": "Text",
          "value": "Disconnect the light connector by pressing the tab and pulling the plastic connector.",
          "font_size": 15
        },
        {
          "oid": "6000000000028",
          "type": "Text",
          "value": "Disconnect the speaker connector by angling it to release the small tab.",
          "font_size": 15
        },
        {
          "oid": "6000000000029",
          "type": "Text",
          "value": "Move the footwell cover aside.",
          "font_size": 15
        },
        {
          "oid": "6000000000030",
          "type": "SmallText",
          "value": "Do NOT pull on the wires. Always grip and pull from the plastic connector body itself. Pulling wires can damage the connections.",
          "font_size": 13,
          "color": "#555555"
        },
        {
          "oid": "6000000000031",
          "type": "Button",
          "value": "Done"
        }
      ],
      "form_layout_config": [
        {
          "deviceType": "phone",
          "canvasWidth": 390,
          "canvasHeight": 844,
          "elements": [
            {
              "type": "header",
