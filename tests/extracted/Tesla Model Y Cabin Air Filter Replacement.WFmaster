    {
      "local_id": "Remove Filter Cover",
      "oid": "6000000000042",
      "version": "1.0.0",
      "last_modified_date": "2026-03-03T02:59:53.001Z",
      "step_type": "USER_INTERACTION",
      "ui_parameter_specifications": [
        {
          "oid": "6000000000034",
          "type": "Header",
          "value": "Remove Filter Cover",
          "font_size": 22,
          "align": "center"
        },
        {
          "oid": "6000000000035",
          "type": "Divider",
          "value": ""
        },
        {
          "oid": "6000000000036",
          "type": "Text",
          "value": "Locate the cabin filter cover on the HVAC module (now visible behind the removed footwell panel).",
          "font_size": 15
        },
        {
          "oid": "6000000000037",
          "type": "Text",
          "value": "Use your index finger and thumb to squeeze the two tabs at the bottom of the filter cover.",
          "font_size": 15
        },
        {
          "oid": "6000000000038",
          "type": "Text",
          "value": "Tilt the cover outward to remove it.",
          "font_size": 15
        },
        {
          "oid": "6000000000039",
          "type": "Text",
          "value": "Set the cover aside.",
          "font_size": 15
        },
        {
          "oid": "6000000000040",
          "type": "SmallText",
          "value": "The cover clips are at the bottom. Squeeze them together firmly before tilting the cover out.",
          "font_size": 13,
          "color": "#555555"
        },
        {
          "oid": "6000000000041",
          "type": "Button",
          "value": "Done"
        }
      ],
      "form_layout_config": [
        {
