        }
      ],
      "ui_parameter_specifications": [
        {
          "oid": "6000000000040",
          "type": "Header",
          "value": "Heat Exchanger & Debris",
          "font_size": 22,
          "align": "center"
        },
        {
          "oid": "6000000000041",
          "type": "Divider",
          "value": ""
        },
        {
          "oid": "6000000000042",
          "type": "Text",
          "value": "Inspect heat exchanger fins for dust, leaves, or cottonwood buildup.",
          "font_size": 15
        },
        {
          "oid": "6000000000043",
          "type": "Text",
          "value": "Check for bent or damaged fins (use a fin comb if needed).",
          "font_size": 15
        },
        {
          "oid": "6000000000044",
          "type": "Text",
          "value": "Look inside the unit for animal nests or insect infestations.",
          "font_size": 15
        },
        {
          "oid": "6000000000045",
          "type": "Text",
          "value": "Verify the drain holes at the bottom of the unit are clear.",
          "font_size": 15
        },
        {
          "oid": "6000000000046",
          "type": "SmallText",
          "value": "A dirty condenser coil can reduce capacity by 20-30%. Schedule a coil cleaning if buildup is moderate or worse.",
          "font_size": 13,
          "color": "#555555"
        },
        {
          "oid": "6000000000048",
          "type": "Text",
          "value": "Debris condition",
          "font_size": 14
        },
        {
          "oid": "6000000000049",
          "type": "TextInput",
          "value": "Clean / Light / Moderate / Heavy"
        },
        {
          "oid": "6000000000050",
          "type": "Text",
          "value": "Notes on debris or damage",
          "font_size": 14
        },
        {
          "oid": "6000000000051",
          "type": "TextInput",
          "value": "Describe any issues found..."
        },
        {
          "oid": "6000000000047",
          "type": "Button",
          "value": "Done"
        }
      ],
