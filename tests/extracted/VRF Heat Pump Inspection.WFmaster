    {
      "local_id": "Condensate Pump Test",
      "oid": "6000000000246",
      "version": "1.0.0",
      "last_modified_date": "2026-03-03T02:47:30.743Z",
      "step_type": "USER_INTERACTION",
      "ui_parameter_specifications": [
        {
          "oid": "6000000000237",
          "type": "Header",
          "value": "Indoor Unit: Condensate Pump",
          "font_size": 22,
          "align": "center"
        },
        {
          "oid": "6000000000238",
          "type": "Divider",
          "value": ""
        },
        {
          "oid": "6000000000239",
          "type": "Text",
          "value": "Locate the secondary drain port on the indoor unit.",
          "font_size": 15
        },
        {
          "oid": "6000000000240",
          "type": "Text",
          "value": "Slowly pour approximately 500ml of water into the port.",
          "font_size": 15
        },
        {
          "oid": "6000000000241",
          "type": "Text",
          "value": "This should trigger the float switch and activate the pump.",
          "font_size": 15
        },
        {
          "oid": "6000000000242",
          "type": "Text",
          "value": "Verify water is pumped out through the condensate line.",
          "font_size": 15
        },
        {
          "oid": "6000000000243",
          "type": "Text",
          "value": "Listen for the pump motor — it should run smoothly without grinding.",
          "font_size": 15
        },
        {
          "oid": "6000000000244",
          "type": "SmallText",
          "value": "If the float switch does not trigger, the unit will eventually overflow and cause water damage. Test this at every inspection.",
          "font_size": 13,
          "color": "#555555"
        },
        {
          "oid": "6000000000245",
          "type": "Button",
          "value": "Done"
        }
      ],
      "form_layout_config": [
        {
          "deviceType": "phone",
          "canvasWidth": 390,
          "canvasHeight": 844,
