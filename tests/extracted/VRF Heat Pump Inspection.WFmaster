    {
      "local_id": "Oil Leak Inspection",
      "oid": "6000000000158",
      "version": "1.0.0",
      "last_modified_date": "2026-03-03T02:47:30.743Z",
      "step_type": "USER_INTERACTION",
      "ui_parameter_specifications": [
        {
          "oid": "6000000000149",
          "type": "Header",
          "value": "Compressor Oil Leak Check",
          "font_size": 22,
          "align": "center"
        },
        {
          "oid": "6000000000150",
          "type": "Image",
          "value": "compressor-area.jpg"
        },
        {
          "oid": "6000000000151",
          "type": "Divider",
          "value": ""
        },
        {
          "oid": "6000000000152",
          "type": "Text",
          "value": "Visually inspect the base of each compressor for oily residue.",
          "font_size": 15
        },
        {
          "oid": "6000000000153",
          "type": "Text",
          "value": "Check all flare joints, brazed connections, and service valves.",
          "font_size": 15
        },
        {
          "oid": "6000000000154",
          "type": "Text",
          "value": "Look for oil stains on piping, particularly at bends and fittings.",
          "font_size": 15
        },
        {
          "oid": "6000000000155",
          "type": "Text",
          "value": "Oily residue indicates a refrigerant leak (oil travels with refrigerant).",
          "font_size": 15
        },
        {
          "oid": "6000000000156",
          "type": "SmallText",
          "value": "VRF systems contain large refrigerant charges. Even small leaks lead to significant capacity loss and environmental impact.",
          "font_size": 13,
          "color": "#555555"
        },
        {
          "oid": "6000000000157",
          "type": "Button",
          "value": "Done"
        }
      ],
      "form_layout_config": [
        {
