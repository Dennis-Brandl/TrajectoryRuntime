    {
      "local_id": "Filter Status",
      "oid": "6000000000224",
      "version": "1.0.0",
      "last_modified_date": "2026-03-03T02:47:30.743Z",
      "step_type": "USER_INTERACTION",
      "ui_parameter_specifications": [
        {
          "oid": "6000000000214",
          "type": "Header",
          "value": "Indoor Unit: Filter Check",
          "font_size": 22,
          "align": "center"
        },
        {
          "oid": "6000000000215",
          "type": "Image",
          "value": "indoor-unit.jpg"
        },
        {
          "oid": "6000000000216",
          "type": "Divider",
          "value": ""
        },
        {
          "oid": "6000000000217",
          "type": "Text",
          "value": "Check the \"Filter Sign\" indicator on the indoor unit remote controller.",
          "font_size": 15
        },
        {
          "oid": "6000000000218",
          "type": "Text",
          "value": "Remove and visually inspect the air filters.",
          "font_size": 15
        },
        {
          "oid": "6000000000219",
          "type": "Text",
          "value": "If clogged: clean with vacuum or rinse with water and air-dry.",
          "font_size": 15
        },
        {
          "oid": "6000000000220",
          "type": "Text",
          "value": "If damaged: replace with correct model filter.",
          "font_size": 15
        },
        {
          "oid": "6000000000221",
          "type": "Text",
          "value": "Reset the filter sign timer after cleaning/replacement.",
          "font_size": 15
        },
        {
          "oid": "6000000000222",
          "type": "SmallText",
          "value": "Dirty filters are the #1 cause of service calls. They reduce airflow, freeze evaporator coils, and increase energy consumption by up to 15%.",
          "font_size": 13,
          "color": "#555555"
        },
        {
          "oid": "6000000000223",
          "type": "Button",
          "value": "Done"
        }
      ],
      "form_layout_config": [
        {
          "deviceType": "phone",
          "canvasWidth": 390,
