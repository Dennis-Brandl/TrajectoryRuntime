    {
      "local_id": "Delta T Measurement",
      "oid": "6000000000258",
      "version": "1.0.0",
      "last_modified_date": "2026-03-03T02:47:30.743Z",
      "step_type": "USER_INTERACTION",
      "ui_parameter_specifications": [
        {
          "oid": "6000000000248",
          "type": "Header",
          "value": "Temperature Differential (ΔT)",
          "font_size": 22,
          "align": "center"
        },
        {
          "oid": "6000000000249",
          "type": "Divider",
          "value": ""
        },
        {
          "oid": "6000000000250",
          "type": "Text",
          "value": "Set the unit to COOLING mode at maximum fan speed.",
          "font_size": 15
        },
        {
          "oid": "6000000000251",
          "type": "Text",
          "value": "Allow 10 minutes for the system to stabilize.",
          "font_size": 15
        },
        {
          "oid": "6000000000252",
          "type": "Text",
          "value": "Measure the Return Air temperature at the intake grille.",
          "font_size": 15
        },
        {
          "oid": "6000000000253",
          "type": "Text",
          "value": "Measure the Supply Air temperature at the discharge grille.",
          "font_size": 15
        },
        {
          "oid": "6000000000254",
          "type": "Text",
          "value": "Calculate ΔT = Return Air - Supply Air.",
          "font_size": 15
        },
        {
          "oid": "6000000000255",
          "type": "Text",
          "value": "Target range: 8°C to 12°C (15°F to 22°F).",
          "font_size": 15
        },
        {
          "oid": "6000000000256",
          "type": "SmallText",
          "value": "Low ΔT may indicate low refrigerant charge, dirty evaporator, or restricted airflow. High ΔT may indicate low airflow (dirty filter or failed fan).",
          "font_size": 13,
          "color": "#555555"
        },
        {
          "oid": "6000000000257",
          "type": "Button",
          "value": "Next"
        }
      ],
      "form_layout_config": [
        {
          "deviceType": "phone",
          "canvasWidth": 390,
          "canvasHeight": 844,
          "elements": [
            {
              "type": "header",
              "x": 20,
              "y": 130,
              "width": 350,
              "height": 36,
              "content": {
                "content": "Temperature Differential (ΔT)",
                "plainText": "Temperature Differential (ΔT)"
              },
              "fontSize": 22,
              "fontWeight": "bold",
              "align": "center"
            },
            {
              "type": "divider",
              "x": 20,
              "y": 176,
              "width": 350,
              "height": 2,
              "thickness": 1,
              "color": "#e2e8f0"
            },
            {
              "type": "text",
              "x": 20,
              "y": 188,
              "width": 350,
              "height": 142,
              "content": {
                "content": "Set the unit to COOLING mode at maximum fan speed.\nAllow 10 minutes for the system to stabilize.\nMeasure the Return Air temperature at the intake grille.\nMeasure the Supply Air temperature at the discharge grille.\nCalculate ΔT = Return Air - Supply Air.\nTarget range: 8°C to 12°C (15°F to 22°F).",
                "plainText": "Set the unit to COOLING mode at maximum fan speed.\nAllow 10 minutes for the system to stabilize.\nMeasure the Return Air temperature at the intake grille.\nMeasure the Supply Air temperature at the discharge grille.\nCalculate ΔT = Return Air - Supply Air.\nTarget range: 8°C to 12°C (15°F to 22°F)."
              },
              "fontSize": 15
            },
            {
              "type": "text",
              "x": 20,
              "y": 340,
              "width": 350,
              "height": 82,
              "content": {
                "content": "Low ΔT may indicate low refrigerant charge, dirty evaporator, or restricted airflow. High ΔT may indicate low airflow (dirty filter or failed fan).",
                "plainText": "Low ΔT may indicate low refrigerant charge, dirty evaporator, or restricted airflow. High ΔT may indicate low airflow (dirty filter or failed fan)."
              },
              "fontSize": 13,
              "color": "#555555"
            },
