    {
      "local_id": "Voltage Measurement",
      "oid": "6000000000065",
      "version": "1.0.0",
      "last_modified_date": "2026-03-03T02:47:30.742Z",
      "step_type": "USER_INTERACTION",
      "ui_parameter_specifications": [
        {
          "oid": "6000000000056",
          "type": "Header",
          "value": "Voltage Symmetry Check",
          "font_size": 22,
          "align": "center"
        },
        {
          "oid": "6000000000057",
          "type": "Image",
          "value": "voltage-test.jpg"
        },
        {
          "oid": "6000000000058",
          "type": "Divider",
          "value": ""
        },
        {
          "oid": "6000000000059",
          "type": "Text",
          "value": "Measure line-to-line voltage at the outdoor unit disconnect.",
          "font_size": 15
        },
        {
          "oid": "6000000000060",
          "type": "Text",
          "value": "Record all three phase-to-phase readings (L1-L2, L2-L3, L1-L3).",
          "font_size": 15
        },
        {
          "oid": "6000000000061",
          "type": "Text",
          "value": "Calculate deviation: ((Max - Min) / Average) x 100.",
          "font_size": 15
        },
        {
          "oid": "6000000000062",
          "type": "Text",
          "value": "Deviation must be less than 2% for safe compressor operation.",
          "font_size": 15
        },
        {
          "oid": "6000000000063",
          "type": "SmallText",
          "value": "Voltage imbalance causes excessive current draw on one phase, leading to winding overheating and premature compressor failure.",
          "font_size": 13,
          "color": "#555555"
        },
        {
          "oid": "6000000000064",
          "type": "Button",
          "value": "Next"
        }
      ],
