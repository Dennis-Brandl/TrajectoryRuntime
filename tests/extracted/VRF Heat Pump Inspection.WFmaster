        {
          "oid": "6000000000208",
          "type": "Text",
          "value": "Within specification?",
          "font_size": 14
        },
        {
          "oid": "6000000000209",
          "type": "TextInput",
          "value": "Yes / No"
        },
        {
          "oid": "6000000000205",
