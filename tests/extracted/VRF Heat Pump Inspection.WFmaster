    {
      "local_id": "Crankcase Heater Check",
      "oid": "6000000000195",
      "version": "1.0.0",
      "last_modified_date": "2026-03-03T02:47:30.743Z",
      "step_type": "USER_INTERACTION",
      "ui_parameter_specifications": [
        {
          "oid": "6000000000187",
          "type": "Header",
          "value": "Crankcase Heater Verification",
          "font_size": 22,
          "align": "center"
        },
        {
          "oid": "6000000000188",
          "type": "Divider",
          "value": ""
        },
        {
          "oid": "6000000000189",
          "type": "Text",
          "value": "Verify the compressor is currently OFF (not running).",
          "font_size": 15
        },
        {
          "oid": "6000000000190",
          "type": "Text",
          "value": "Use a clamp ammeter on the crankcase heater circuit.",
          "font_size": 15
        },
        {
          "oid": "6000000000191",
          "type": "Text",
          "value": "Confirm current draw matches the nameplate specification.",
          "font_size": 15
        },
        {
          "oid": "6000000000192",
          "type": "Text",
          "value": "If no current: check the heater relay, wiring, and heater element.",
          "font_size": 15
        },
        {
          "oid": "6000000000193",
          "type": "SmallText",
          "value": "The crankcase heater prevents liquid refrigerant from pooling in the compressor oil sump during off-cycles. A failed heater leads to compressor slugging on startup.",
          "font_size": 13,
          "color": "#555555"
        },
        {
          "oid": "6000000000194",
          "type": "Button",
          "value": "Done"
        }
      ],
      "form_layout_config": [
        {
          "deviceType": "phone",
          "canvasWidth": 390,
