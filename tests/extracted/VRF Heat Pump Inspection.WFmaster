    {
      "local_id": "Vane Motor Check",
      "oid": "6000000000286",
      "version": "1.0.0",
      "last_modified_date": "2026-03-03T02:47:30.743Z",
      "step_type": "USER_INTERACTION",
      "ui_parameter_specifications": [
        {
          "oid": "6000000000277",
          "type": "Header",
          "value": "Louver / Vane Motor Test",
          "font_size": 22,
          "align": "center"
        },
        {
          "oid": "6000000000278",
          "type": "Divider",
          "value": ""
        },
        {
          "oid": "6000000000279",
          "type": "Text",
          "value": "Use the remote controller to cycle the louvers through full range.",
          "font_size": 15
        },
        {
          "oid": "6000000000280",
          "type": "Text",
          "value": "Observe horizontal vanes (up/down) through complete travel.",
          "font_size": 15
        },
        {
          "oid": "6000000000281",
          "type": "Text",
          "value": "Observe vertical vanes (left/right) through complete travel.",
          "font_size": 15
        },
        {
          "oid": "6000000000282",
          "type": "Text",
          "value": "Listen for clicking, grinding, or sticking during movement.",
          "font_size": 15
        },
        {
          "oid": "6000000000283",
          "type": "Text",
          "value": "Vanes should move smoothly and return to set position.",
          "font_size": 15
        },
        {
          "oid": "6000000000284",
          "type": "SmallText",
          "value": "A sticking vane motor usually indicates a worn gear or bearing. Replace the motor before it fails completely — a stuck louver directs all airflow to one zone.",
          "font_size": 13,
          "color": "#555555"
        },
        {
          "oid": "6000000000285",
          "type": "Button",
          "value": "Done"
        }
      ],
