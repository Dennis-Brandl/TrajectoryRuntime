              },
              "fontSize": 22,
              "fontWeight": "bold",
              "align": "center"
            },
            {
              "type": "divider",
              "x": 20,
              "y": 176,
              "width": 350,
              "height": 2,
              "thickness": 1,
              "color": "#e2e8f0"
            },
            {
              "type": "text",
              "x": 20,
              "y": 188,
              "width": 350,
              "height": 98,
              "content": {
                "content": "Verify the compressor is currently OFF (not running).\nUse a clamp ammeter on the crankcase heater circuit.\nConfirm current draw matches the nameplate specification.\nIf no current: check the heater relay, wiring, and heater element.",
                "plainText": "Verify the compressor is currently OFF (not running).\nUse a clamp ammeter on the crankcase heater circuit.\nConfirm current draw matches the nameplate specification.\nIf no current: check the heater relay, wiring, and heater element."
              },
              "fontSize": 15
            },
            {
              "type": "text",
              "x": 20,
              "y": 296,
              "width": 350,
              "height": 82,
              "content": {
                "content": "The crankcase heater prevents liquid refrigerant from pooling in the compressor oil sump during off-cycles. A failed heater leads to compressor slugging on startup.",
                "plainText": "The crankcase heater prevents liquid refrigerant from pooling in the compressor oil sump during off-cycles. A failed heater leads to compressor slugging on startup."
              },
              "fontSize": 13,
              "color": "#555555"
            },
            {
              "type": "button",
              "x": 95,
              "y": 680,
              "width": 200,
              "height": 44,
              "label": "Done",
              "outputValue": "done"
            }
          ]
        },
