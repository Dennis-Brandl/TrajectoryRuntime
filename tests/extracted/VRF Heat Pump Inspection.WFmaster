    {
      "local_id": "Drain Pan Inspection",
      "oid": "6000000000235",
      "version": "1.0.0",
      "last_modified_date": "2026-03-03T02:47:30.743Z",
      "step_type": "USER_INTERACTION",
      "ui_parameter_specifications": [
        {
          "oid": "6000000000226",
          "type": "Header",
          "value": "Indoor Unit: Drain Pan",
          "font_size": 22,
          "align": "center"
        },
        {
          "oid": "6000000000227",
          "type": "Divider",
          "value": ""
        },
        {
          "oid": "6000000000228",
          "type": "Text",
          "value": "Remove the drain pan access cover.",
          "font_size": 15
        },
        {
          "oid": "6000000000229",
          "type": "Text",
          "value": "Inspect for standing water (indicates a blocked drain).",
          "font_size": 15
        },
        {
          "oid": "6000000000230",
          "type": "Text",
          "value": "Check for slime, mold, or algae growth.",
          "font_size": 15
        },
        {
          "oid": "6000000000231",
          "type": "Text",
          "value": "Clean the pan with a mild disinfectant if contaminated.",
          "font_size": 15
        },
        {
          "oid": "6000000000232",
          "type": "Text",
          "value": "Verify the drain line is flowing freely.",
          "font_size": 15
        },
        {
          "oid": "6000000000233",
          "type": "SmallText",
          "value": "Biological growth in drain pans can cause health hazards and foul odors. Consider installing condensate pan treatment tablets for prevention.",
          "font_size": 13,
          "color": "#555555"
        },
        {
          "oid": "6000000000234",
          "type": "Button",
          "value": "Done"
        }
      ],
      "form_layout_config": [
