      "ui_parameter_specifications": [
        {
          "oid": "6000000000002",
          "type": "Header",
          "value": "Clearance Inspection",
          "font_size": 22,
          "align": "center"
        },
        {
          "oid": "6000000000003",
          "type": "Image",
          "value": "clearance-check.jpg"
        },
        {
          "oid": "6000000000004",
          "type": "Divider",
          "value": ""
        },
        {
          "oid": "6000000000005",
          "type": "Text",
          "value": "Verify at least 500mm (20 in) of clearance around all intake grilles.",
          "font_size": 15
        },
        {
          "oid": "6000000000006",
          "type": "Text",
          "value": "Measure the clearance on each side of the outdoor unit.",
          "font_size": 15
        },
        {
          "oid": "6000000000007",
          "type": "Text",
          "value": "Restricted airflow reduces efficiency and can cause compressor overheating.",
          "font_size": 15
        },
        {
          "oid": "6000000000008",
          "type": "SmallText",
          "value": "Mitsubishi City Multi units require unobstructed airflow for proper heat exchange. Check for new obstructions such as vegetation growth or stored equipment.",
          "font_size": 13,
          "color": "#555555"
        },
        {
          "oid": "6000000000009",
          "type": "Button",
          "value": "Next"
        }
      ],
