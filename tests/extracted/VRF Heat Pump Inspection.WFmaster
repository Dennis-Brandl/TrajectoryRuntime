        },
        {
          "id": "ipm_in_spec",
          "oid": "6000000000211",
          "description": "Within specification?"
        }
      ],
      "ui_parameter_specifications": [
        {
          "oid": "6000000000197",
          "type": "Header",
          "value": "Inverter IPM Resistance Check",
          "font_size": 22,
          "align": "center"
        },
        {
          "oid": "6000000000198",
          "type": "Divider",
          "value": ""
        },
        {
          "oid": "6000000000199",
          "type": "Text",
          "value": "Disconnect power and wait 5 minutes for capacitors to discharge.",
          "font_size": 15
        },
        {
          "oid": "6000000000200",
          "type": "Text",
          "value": "Set multimeter to resistance (ohms) mode.",
          "font_size": 15
        },
        {
          "oid": "6000000000201",
          "type": "Text",
          "value": "Measure resistance of the IPM (Intelligent Power Module).",
          "font_size": 15
        },
        {
          "oid": "6000000000202",
          "type": "Text",
          "value": "Compare readings to the service manual specifications.",
          "font_size": 15
        },
        {
          "oid": "6000000000203",
          "type": "Text",
          "value": "Asymmetric readings indicate a failed power semiconductor.",
          "font_size": 15
        },
        {
          "oid": "6000000000204",
          "type": "SmallText",
          "value": "SAFETY: Confirm zero voltage with a meter before touching any inverter components. DC bus capacitors store lethal energy.",
          "font_size": 13,
          "color": "#555555"
        },
        {
          "oid": "6000000000206",
          "type": "Text",
          "value": "IPM resistance reading (ohms)",
          "font_size": 14
        },
        {
          "oid": "6000000000207",
          "type": "TextInput",
          "value": "e.g., Open / 5.2M / Short"
