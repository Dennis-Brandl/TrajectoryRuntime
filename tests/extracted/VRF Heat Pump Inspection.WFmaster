    {
      "local_id": "Structure Check",
      "oid": "6000000000038",
      "version": "1.0.0",
      "last_modified_date": "2026-03-03T02:47:30.742Z",
      "step_type": "USER_INTERACTION",
      "ui_parameter_specifications": [
        {
          "oid": "6000000000029",
          "type": "Header",
          "value": "Structural Integrity",
          "font_size": 22,
          "align": "center"
        },
        {
          "oid": "6000000000030",
          "type": "Image",
          "value": "outdoor-unit.jpg"
        },
        {
          "oid": "6000000000031",
          "type": "Divider",
          "value": ""
        },
        {
          "oid": "6000000000032",
          "type": "Text",
          "value": "Inspect all mounting bolts for tightness using the appropriate wrench.",
          "font_size": 15
        },
        {
          "oid": "6000000000033",
          "type": "Text",
          "value": "Check the concrete or steel base for vibration-induced cracking.",
          "font_size": 15
        },
        {
          "oid": "6000000000034",
          "type": "Text",
          "value": "Look for rust or corrosion on mounting hardware.",
          "font_size": 15
        },
        {
          "oid": "6000000000035",
          "type": "Text",
          "value": "Verify the unit is level (use a spirit level if available).",
          "font_size": 15
        },
        {
          "oid": "6000000000036",
          "type": "SmallText",
          "value": "VRF compressors generate significant vibration. Loose mounting leads to refrigerant line fatigue and premature failure.",
          "font_size": 13,
          "color": "#555555"
        },
        {
          "oid": "6000000000037",
          "type": "Button",
          "value": "Done"
        }
      ],
